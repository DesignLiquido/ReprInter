importar padrao.es : { escrevaln }

declarar fibonacci(n inteiro) inteiro {
    se n <= 1 retorne n
    alocar a int = 0
    alocar b int = 1
    alocar tmp int = 0
    para alocar i int = 0; i < n - 1; i++ {
        tmp = a + b
        a = b
        b = tmp
    }
    retorne b
}

declarar principal vazio {
    alocar resultado int = fibonacci(92)
    escrevaln("resultado: ", resultado)
    se resultado != 7540113804746346429 {
        escrevaln("o resultado está errado!")
    }
    fim
}
