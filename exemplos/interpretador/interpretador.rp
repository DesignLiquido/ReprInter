// interpretador de calculos matematicos simples

importar biblioteca.entrada_saida
importar biblioteca.arquivo : { lerArquivo, ARQUIVO }

enum TokenTipo {
    Numero = "Numero"               // 0..9 || 0..9.0..9
    Mais = "Mais"                   // +
    Menos = "Menos"                 // -
    Vezes = "Vezes"                 // *
    Dividir = "Dividir"             // /
    Igual = "Igual"                 // =
    Identificador = "Identificador" // a-zA-Z
    ParentesesE = "ParentesesE"     // (
    ParentesesD = "ParentesesD"     // )
    EoF = "FimDoArquivo"            // Fim do Arquivo (End of File)
}

// vai servir como um sistema de contextos simples (muito simples)
estrutura Tabela* {
    simbolos Simbolo[]
    tamanho int // tamanho do vetor de simbolos
}

estrutura Simbolo {
    tipo Tipo
    nome txt
    valor qualquer // inteiro ou decimal
}

declarar set(tabela ref Tabela, nome txt, tipo ref Tipo, valor qualquer = 0) int {
    alocar tamanho int = @tamanho_vetor(tabela.tamanho)
    alocar idx int = -1
    para alocar i int = 0; i < tamanho; i++
        se tabela.simbolos[i].nome == nome {
            idx = i
        }
    se idx == -1 {
        tabela.simbolos ~= Simbolo(tipo, nome, valor)
        tabela.tamanho++
    } senao {
        tabela.simbolos[idx].valor = valor
        tabela.simbolos[idx].tipo = tipo
    }
    retorne tabela.tamanho
}

declarar get(tabela ref Tabela, nome txt) Simbolo {
    alocar tamanho int = tabela.tamanho
    para alocar i int = 0; i < tamanho; i++
        se tabela.simbolos[i].nome == nome
            retorne tabela.simbolos[i]
    escrevaf("Variavel não encontrada: '%s'\n", nome)
    fim
}

enum OpCode {
    Tirar = "Tirar"
    Empurrar = "Empurrar"
    Escreva = "Escreva"

    Adicionar = "Adicionar"
    Multiplicar = "Multiplicar"
    Dividir = "Dividir"
    Subtrair = "Subtrair"
    
    Armazenar = "Armazenar"
    Carregar = "Carregar"
    Fim = "Fim"
}

enum Tipo {
    Inteiro = "Inteiro"
    Decimal = "Decimal"
    Texto = "Texto"
}

estrutura Valor {
    tipo Tipo
    valor qualquer // qualquer = any
}

estrutura Instrucao {
    op OpCode
    valor Valor
}

estrutura MaquinaVirtual {
    pilha Valor[]
    programa Instrucao[]
}

declarar criarInteiro(valor int = 0) Valor {
    retorne Valor(Tipo.Inteiro, valor)
}

declarar criarDecimal(valor decimal = 0.0) Valor {
    retorne Valor(Tipo.Decimal, valor)
}

declarar criarTexto(valor txt) Valor {
    retorne Valor(Tipo.Texto, valor)
}

declarar pop(vm ref MaquinaVirtual) Valor {
    alocar tam int = @tamanho_vetor(vm.pilha)
    se tam == 0 {
        // pilha vazia, erro
        escrevaln("Pilha vazia!")
        fim
    }
    alocar ultimo Valor = vm.pilha[tam - 1]
    vm.pilha = @vetor_pop(vm.pilha)
    retorne ultimo
}

declarar executar(vm ref MaquinaVirtual, tabela ref Tabela) vazio {
    alocar instrucoes Instrucao[] = vm.programa
    alocar tam int = @tamanho_vetor(instrucoes)
    // contador do programa (program counter)
    alocar pc int = 0
    enquanto pc < tam {
        alocar instrucao Instrucao = instrucoes[pc]
        se instrucao.op == OpCode.Empurrar {
            // adiciona na pilha com push
            vm.pilha ~= instrucao.valor
            pc++
            continuar
        }
        se instrucao.op == OpCode.Adicionar {
            // adiciona na pilha com push
            alocar b Valor = pop(vm)
            alocar a Valor = pop(vm)
            
            // o valor será alterado, ele apenas foi inicializado
            alocar resultado Valor = Valor(Tipo.Inteiro, 0)

            se (b.tipo == Tipo.Decimal && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Inteiro && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Decimal && a.tipo == Tipo.Inteiro)
                resultado = criarDecimal(a.valor + b.valor)
            senao se b.tipo == Tipo.Inteiro && a.tipo == Tipo.Inteiro
                resultado = criarInteiro(a.valor + b.valor)
            senao {
                escrevaln("Erro no operador Adicionar")
                fim
            }
            vm.pilha ~= resultado
            pc++
            continuar
        }
        se instrucao.op == OpCode.Subtrair {
            // adiciona na pilha com push
            alocar b Valor = pop(vm)
            alocar a Valor = pop(vm)
            
            // o valor será alterado, ele apenas foi inicializado
            alocar resultado Valor = Valor(Tipo.Inteiro, 0)

            se (b.tipo == Tipo.Decimal && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Inteiro && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Decimal && a.tipo == Tipo.Inteiro)
                resultado = criarDecimal(a.valor - b.valor)
            senao se b.tipo == Tipo.Inteiro && a.tipo == Tipo.Inteiro
                resultado = criarInteiro(a.valor - b.valor)
            senao {
                escrevaln("Erro no operador Subtrair")
                fim
            }
            vm.pilha ~= resultado
            pc++
            continuar
        }
        se instrucao.op == OpCode.Multiplicar {
            // adiciona na pilha com push
            alocar b Valor = pop(vm)
            alocar a Valor = pop(vm)
            
            // o valor será alterado, ele apenas foi inicializado
            alocar resultado Valor = Valor(Tipo.Inteiro, 0)

            se (b.tipo == Tipo.Decimal && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Inteiro && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Decimal && a.tipo == Tipo.Inteiro)
                resultado = criarDecimal(a.valor * b.valor)
            senao se b.tipo == Tipo.Inteiro && a.tipo == Tipo.Inteiro
                resultado = criarInteiro(a.valor * b.valor)
            senao {
                escrevaln("Erro no operador Multiplicar")
                fim
            }
            vm.pilha ~= resultado
            pc++
            continuar
        }
        se instrucao.op == OpCode.Dividir {
            // adiciona na pilha com push
            alocar b Valor = pop(vm)
            alocar a Valor = pop(vm)
            
            // o valor será alterado, ele apenas foi inicializado
            alocar resultado Valor = Valor(Tipo.Inteiro, 0)

            se b.valor == 0 || b.valor == 0.0 {
                escrevaln("Divisão por zero encontrada!")
                fim
            }

            se (b.tipo == Tipo.Decimal && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Inteiro && a.tipo == Tipo.Decimal)
                || (b.tipo == Tipo.Decimal && a.tipo == Tipo.Inteiro)
                resultado = criarDecimal(a.valor / b.valor)
            senao se b.tipo == Tipo.Inteiro && a.tipo == Tipo.Inteiro
                resultado = criarInteiro(a.valor / b.valor)
            senao {
                escrevaln("Erro no operador Dividir")
                fim
            }
            vm.pilha ~= resultado
            pc++
            continuar
        }
        se instrucao.op == OpCode.Armazenar {
            alocar val Valor = pop(vm)
            alocar var Valor = instrucao.valor
            set(tabela, var.valor, val.tipo, val.valor)
            pc++
            continuar
        }
        se instrucao.op == OpCode.Carregar {
            alocar var Valor = instrucao.valor
            alocar sim Simbolo = get(tabela, var.valor)
            vm.pilha ~= Valor(sim.tipo, sim.valor)
            pc++
            continuar
        }
        se instrucao.op == OpCode.Escreva {
            escrevaln(pop(vm).valor)
            pc++
            continuar
        }
        se instrucao.op == OpCode.Fim
            // para tudo
            retorne;
    }
}

estrutura Token {
    tipo TokenTipo // numero e simbolo
    valor txt // 1, 2, +, ...
}

estrutura Lexer {
    source txt
    offset int
    tamanho int
}

declarar eTexto(ch txt) logico {
    retorne (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_"
}

declarar eNumero(ch txt) logico {
    retorne ch >= "0" && ch <= "9"
}

declarar eEspaco(ch txt) logico {
    retorne ch == " " || ch == "\t" || ch == "\n"
}

declarar tokenize(src txt, tamanho int) Token[] {
    alocar tokens Token[] = []
    alocar ch txt = ""
    alocar offset int = 0

    enquanto offset < tamanho {
        ch = src[offset++]
        se eEspaco(ch) continuar
        se eNumero(ch) {
            alocar numero txt = ""
            // adiciona o dígito já lido
            numero ~= ch
            // consome dígitos seguintes com checagem de limite
            enquanto offset < tamanho && eNumero(src[offset]) {
                numero ~= src[offset++]
            }
            se src[offset] == "." {
                // numero decimal
                numero ~= "."
                offset++ // pula o '.'
                enquanto offset < tamanho && eNumero(src[offset]) {
                    numero ~= src[offset++]
                }
            }
            tokens ~= Token(TokenTipo.Numero, numero)
            continuar
        }
        se eTexto(ch) {
            alocar id txt = ""
            // adiciona o ch já lido
            id ~= ch
            // consome os outros caracteres
            enquanto offset < tamanho && eTexto(src[offset]) {
                id ~= src[offset++]
            }
            tokens ~= Token(TokenTipo.Identificador, id)
            continuar
        }
        // simbolos/sinais
        se ch == "+" { tokens ~= Token(TokenTipo.Mais, ch) continuar }
        se ch == "-" { tokens ~= Token(TokenTipo.Menos, ch) continuar }
        se ch == "*" { tokens ~= Token(TokenTipo.Vezes, ch) continuar }
        se ch == "(" { tokens ~= Token(TokenTipo.ParentesesE, ch) continuar }
        se ch == ")" { tokens ~= Token(TokenTipo.ParentesesD, ch) continuar }
        se ch == "=" { tokens ~= Token(TokenTipo.Igual, ch) continuar }
        se ch == "/" { 
            // comentario
            se src[offset] == "/" {
                enquanto offset < tamanho && src[offset] != "\n"
                    offset++
                continuar
            }
            tokens ~= Token(TokenTipo.Dividir, ch) 
            continuar
        }

        // erro, caractere desconhecido
        escrevaf("Caractere desconhecido: \"%s\"\n", ch)
        fim
    }

    tokens ~= Token(TokenTipo.EoF, "\0")
    retorne tokens
}

enum NodeKind {
    BinOp = "BinOp"
    Numero = "Numero"
    VarDecl = "VarDecl"
    Identificador = "Identificador"
}

estrutura ASTNode {
    tipo NodeKind  // "BinOp", "Numero", etc
    op txt         // "+", "-", "*", "/"
    esq int        // índice esquerdo
    dir int        // índice direito
    valor txt      // para números
}

estrutura Parser {
    tokens Token[]
    pos int
    nos ASTNode[]  // lista de todos os nós
}

declarar novoParse(tokens Token[]) Parser {
    retorne Parser(tokens, 0, [])
}

declarar atual(p ref Parser) Token {
    se p.pos >= @tamanho_vetor(p.tokens) {
        escrevaln("ERROR")
        fim
    }
    retorne p.tokens[p.pos]
}

declarar adicionarNo(p ref Parser, no ref ASTNode) int {
    // adiciona o nó à lista e retorna seu índice
    alocar idx int = @tamanho_vetor(p.nos)
    p.nos ~= no
    retorne idx
}

declarar parseFator(p ref Parser) int {  // retorna índice
    alocar tk Token = atual(p)

    se tk.tipo == TokenTipo.Numero {
        p.pos++
        retorne adicionarNo(p, ASTNode(NodeKind.Numero, "", -1, -1, tk.valor))
    }
    
    se tk.tipo == TokenTipo.ParentesesE {
        p.pos++
        alocar idxExpr int = parseExpressao(p)
        p.pos++
        retorne idxExpr
    }

    se tk.tipo == TokenTipo.Identificador {
        p.pos++
        se atual(p).tipo == TokenTipo.Igual {    
            p.pos++
            alocar idxExpr int = parseExpressao(p)
            // vou salvar o id da expressao no ASTNode.dir
            retorne adicionarNo(p, ASTNode(NodeKind.VarDecl, "", -1, idxExpr, tk.valor))
        }
        retorne adicionarNo(p, ASTNode(NodeKind.Identificador, "", -1, -1, tk.valor))
    }
    
    escrevaf("Erro de sintaxe!: \"%s\"", tk.tipo)
    fim
}

declarar parseTermo(p ref Parser) int {
    alocar idxEsq int = parseFator(p)
    
    enquanto atual(p).tipo == TokenTipo.Vezes || atual(p).tipo == TokenTipo.Dividir {
        alocar op txt = atual(p).valor
        p.pos++
        alocar idxDir int = parseFator(p)
        alocar no ASTNode = ASTNode(NodeKind.BinOp, op, idxEsq, idxDir, "")
        idxEsq = adicionarNo(p, no)
    }
    
    retorne idxEsq
}

declarar parseExpressao(p ref Parser) int {
    alocar idxEsq int = parseTermo(p)
    
    enquanto atual(p).tipo == TokenTipo.Mais || atual(p).tipo == TokenTipo.Menos {
        alocar op txt = atual(p).valor
        p.pos++
        alocar idxDir int = parseTermo(p)
        alocar no ASTNode = ASTNode(NodeKind.BinOp, op, idxEsq, idxDir, "")
        idxEsq = adicionarNo(p, no)
    }
    
    retorne idxEsq
}

declarar gerarBytecode(vm ref MaquinaVirtual, ast ref ASTNode[], raiz int) vazio {
    gerarNo(vm, ast, raiz)
    vm.programa ~= Instrucao(OpCode.Fim, criarInteiro())
}

declarar gerarNo(vm ref MaquinaVirtual, ast ref ASTNode[], idx int) vazio {
    alocar node ASTNode = ast[idx]
    
    se node.tipo == NodeKind.Numero {
        // Empurra número literal na pilha
        alocar val decimal = @tpd(node.valor)
        vm.programa ~= Instrucao(OpCode.Empurrar, criarDecimal(val))
        retorne;
    }
    
    se node.tipo == NodeKind.BinOp {
        // Gera código para subexpressões (recursivo)
        gerarNo(vm, ast, node.esq)
        gerarNo(vm, ast, node.dir)
        
        // Emite operador
        se node.op == "+" vm.programa ~= Instrucao(OpCode.Adicionar, criarInteiro())
        se node.op == "-" vm.programa ~= Instrucao(OpCode.Subtrair, criarInteiro())
        se node.op == "*" vm.programa ~= Instrucao(OpCode.Multiplicar, criarInteiro())
        se node.op == "/" vm.programa ~= Instrucao(OpCode.Dividir, criarInteiro())
        retorne;
    }
    
    se node.tipo == NodeKind.VarDecl {
        // Gera expressão do valor
        gerarNo(vm, ast, node.dir)
        // Armazena na variável
        vm.programa ~= Instrucao(OpCode.Armazenar, criarTexto(node.valor))
        retorne;
    }
    
    se node.tipo == NodeKind.Identificador {
        // Carrega variável
        vm.programa ~= Instrucao(OpCode.Carregar, criarTexto(node.valor))
        retorne;
    }
}

declarar interpretador*(tabela ref Tabela, conteudo txt, tamanho int) decimal {
    alocar tokens Token[] = tokenize(conteudo, tamanho)
    alocar tokensTam int = @tamanho_vetor(tokens)

    // se o tamanho do tokensTam for 1 então não há operações
    // há apenas o EoF
    // então retorna o 0.0 como padrão (fallback)
    se tokensTam == 1
        retorne 0.0

    //para alocar i int = 0; i < tokensTam; i++ {
    //    alocar tk Token = tokens[i]
    //    escrevaf("Tipo do token: %s\nValor: %s\n-----------------\n", tk.tipo, tk.valor)
    //}

    alocar parser Parser = novoParse(tokens)
    alocar raiz int = parseExpressao(parser)
    alocar ast ASTNode[] = parser.nos
    alocar nosTam int = @tamanho_vetor(ast)

    alocar vm MaquinaVirtual = MaquinaVirtual([], [])
    gerarBytecode(vm, ast, raiz)
    executar(vm, tabela)
    
    //escrevaln("\nNÓS:")

    //para alocar i int = 0; i < nosTam; i++ {
    //    alocar no ASTNode = ast[i]
    //    escrevaf("Tipo: %s\nValor: %s %d %d\n-----------------\n", no.tipo, no.valor, no.esq, no.dir)
    //}

    se @tamanho_vetor(vm.pilha) > 0
        retorne pop(vm).valor

    retorne 0.0
}

declarar principal vazio {
    alocar conteudo txt = ""
    alocar tamanho int = 0
    alocar tabela Tabela = Tabela([], 0)

    alocar modoRepl logico = falso
    alocar opt txt = entrada("Deseja o modo repl (s/n)? ")

    // suporte a modo REPL
    se opt == "s" || opt == "sim" || opt == "S" || opt == "SIM"
        modoRepl = verdadeiro

    se !modoRepl {
        alocar arquivo ARQUIVO = lerArquivo("tests/um_mais_um.rrp")
        conteudo = arquivo.conteudo
        tamanho  = @tamanho_texto(conteudo)

        se arquivo.erro > 0 {
            escrevaf("Ocorreu um erro ao ler o arquivo: %s\n", conteudo)
            fim
        }

        escrevaln(interpretador(tabela, conteudo, tamanho))
        fim
    }

    alocar loop logico = verdadeiro

    enquanto loop {
        escrevaln("Modo interativo (para sair escreva 'q')")
        opt = entrada(">>> ")

        se opt == "q" || opt == "Q" || opt == "sair" || opt == "s" {
            loop = falso
            escrevaln("Até mais!")
            continuar
        }

        tamanho = @tamanho_texto(opt)
        // para evitar erro
        opt ~= "\n" // adiciona a quebra de linha para simular a mesma quebra de linha dos arquivos
        alocar resultado decimal = interpretador(tabela, opt, tamanho)
        se resultado != 0.0
            escrevaln(resultado)
    }

    fim
}
