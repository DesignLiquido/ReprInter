externo {
	declarar escreva(...) vazio;
}

declarar saudar(nome texto = "Visitante", idade inteiro = 18) vazio {
    escreva("Olá, ", nome, "! Idade: ", idade, "\n")
}

declarar principal vazio {
    saudar()                          // Olá, Visitante! Idade: 18
    saudar("Ana")                     // Olá, Ana! Idade: 18
    saudar("João", 25)                // Olá, João! Idade: 25
    fim
}
