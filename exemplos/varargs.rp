importar biblioteca.entrada_saida

declarar somatorio(mensagem texto, ...inteiro|decimal) vazio {
    escrevaln(mensagem)
    escrevaln("varargc: ", varargc)
    para alocar i int = 0; i < varargc; i++
        escrevaln(varargs[i])
}

declarar media(...decimal) decimal {
    alocar resultado decimal = 0.0
    para alocar i int = 0; i < varargc; i++
        resultado += varargs[i]
    retorne resultado / varargc
}

declarar principal vazio {
    alocar m decimal = media(1.0, 10.0)
    escrevaln(m)
    fim
}
