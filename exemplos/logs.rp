externo {
    declarar escrevaf(msg texto, ...) vazio;
}

declarar log(
    mensagem texto,
    nivel texto = "INFO",
    timestamp inteiro = 69
) vazio {
    escrevaf("[%s] %s\n", nivel, mensagem, "\n")
}

declarar principal vazio {
    log("Sistema iniciado")
    log("Erro crítico!", "ERROR")
    log("Debug info", "DEBUG", 12345)
    fim
}
