importar biblioteca.entrada_saida

declarar soma(x qqr, y qqr) qualquer {
    retorne x + y
}

declarar principal vazio {
    alocar resultado1 qqr = soma(60, 9)
    alocar resultado2 qqr = soma(60.00000001, 9.00000001)
    // soma de tipos diferentes
    alocar resultado3 decimal = 60 + 9.0 + (resultado1 - resultado2) + (0.00000001 * 2)

    escrevaf("%d\n", resultado1)
    escrevaf("%.8f\n", resultado2)
    escrevaf("%.8f\n", resultado3)
    fim
}
