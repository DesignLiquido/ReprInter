externo {
    declarar escreva(...) vazio;
    declarar escrevaln(...) vazio;
    declarar escrevaf(msg txt, ...) vazio;
}

declarar principal vazio {
    alocar pesos decimal[] = [0.3, 0.4]
    alocar entrada decimal[] = [1.0, 1.0]
    alocar erro decimal = 1.0
    alocar resultadoEsperado decimal = 0
    alocar resultadoTmp qualquer = 0

    enquanto erro != 0.0 {
        se entrada[0] == 1.0
            se entrada[1] == 1.0
                resultadoEsperado = 1.0
        senao
            resultadoEsperado = 0.0
        
        alocar somatoria qqr = (pesos[0] * entrada[0]) + (pesos[1] * entrada[1])
        
        se somatoria < 1.0
            resultadoTmp = 0.0
        senao
            se somatoria >= 1.0
                resultadoTmp = 1.0

        escrevaln("resultado: ", resultadoTmp)

        erro = resultadoEsperado - resultadoTmp

        escrevaln("p1: ", pesos[0])
        escrevaln("p2: ", pesos[1])

        pesos[0] = 0.1 * entrada[0] * erro + pesos[0]
        pesos[1] = 0.1 * entrada[1] * erro + pesos[1]

        escrevaln("erro: ", erro)
    }

    fim
}
