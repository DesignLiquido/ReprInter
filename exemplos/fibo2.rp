externo {
    declarar escrevaln(...) vazio;
}

declarar fibonacci(n inteiro) decimal {
    alocar phi decimal = 1.618033988749
    alocar psi decimal = -0.618033988749
    alocar sqrt5 decimal = 2.236067977499
    
    alocar phi_n decimal = 1.0
    alocar psi_n decimal = 1.0
    
    para alocar i inteiro = 0; i < n; i++ {
        phi_n *= phi
        psi_n *= psi
    }
    
    retorne (phi_n - psi_n) / sqrt5
}

declarar principal vazio {
    alocar resultado f64 = fibonacci(10)
    escrevaln("resultado: ~", resultado)
    fim
}
