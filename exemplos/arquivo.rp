estrutura ARQUIVO {
    conteudo texto   // se erro = 1 então esse campo (field) terá uma mensagem de erro
    tamanho  inteiro // em bytes
    erro     inteiro // 0 = sem erro; 1 = erro
}

externo {
    declarar escrevaln(...) vazio;
    declarar escreva(...) vazio;
    declarar escrevaf(msg texto = "", ...) vazio;
    declarar lerArquivo(arquivo texto) ARQUIVO;
}

declarar principal vazio {
    alocar arquivo ARQUIVO = lerArquivo("tests/teste.txt")

    se arquivo.erro == 1
        escrevaf("Ocorreu um erro ao tentar abrir o arquivo: %s\n", arquivo.conteudo)
    senao
        escrevaf("%s", arquivo.conteudo)

    fim
}
