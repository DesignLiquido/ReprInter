enum Status {
    Pago
    Pendente
}

externo {
    declarar escrevaln(...) vazio;
}

declarar principal vazio {
    // recebe o tipo da enum sendo "Status" mas o valor guarda o valor do campo que foi definido
    alocar pago Status = Status.Pago
    alocar pendente Status = Status.Pendente

    se Status.Pago == Status.Pago {
        escrevaln("Sucesso ao validar")
    }

    fim
}
