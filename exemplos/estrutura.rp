externo {
    declarar escrevaln(...) vazio;
}

estrutura Usuario {
    nome texto
    idade inteiro
}

declarar criarUsuario(nome texto = "Desconhecido", idade inteiro = 69) Usuario {
    retorne Usuario(nome, idade)
}

// nao consegue pois não é por referencia
declarar modificarNomeSemRef(u Usuario) vazio {
    u.nome = "Nando"
}

// consegue pois não é por referencia
declarar modificarNomePorRef(u ref Usuario) vazio {
    u.nome = "Nando"
}

declarar principal vazio {
    alocar u Usuario = Usuario("Fernando", 17)
    alocar copia Usuario = @duplicar(u)
    copia.nome = "João"

    escrevaln(u.nome)
    escrevaln(copia.nome)

    alocar copia_da_copia Usuario = copia
    copia_da_copia.nome = "Alterado"

    // permanece Fernando
    modificarNomeSemRef(u)
    escrevaln(u.nome)

    // u.nome agora é "Nando"
    modificarNomePorRef(u)
    escrevaln(u.nome)

    escrevaln(copia.nome)
    escrevaln(copia_da_copia.nome)

    // criando a estrutura com uma funcao
    alocar desconhecido Usuario = criarUsuario()
    escrevaln(desconhecido.nome)

    fim
}
