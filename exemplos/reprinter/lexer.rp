importar "io.rp"

enum TokenKind* {
    Identificador = "Identificador"

    // palavras chave
    Alocar = "Alocar"
    Principal = "Principal"
    Declarar = "Declarar"

    // tipos
    Vazio = "Vazio"
    Inteiro = "Inteiro"
    Decimal = "Decimal"
    Texto = "Texto"

    // simbolos
    Mais = "Mais" // +
    Menos = "Menos" // -
    Vezes = "Vezes" // *
    Dividir = "Dividir" // /
    ParentesesE = "ParentesesE" // (
    ParentesesD = "ParentesesD" // )
    Igual = "Igual" // =
    BracoE = "BracoE" // {
    BracoD = "BracoD" // }

    EoF = "EoF"
}

estrutura Token* {
    tipo TokenKind
    valor texto // bruto
}

estrutura Lexer* {
    tokens Token[]
    source texto
}

declarar eTexto*(ch txt) logico { retorne (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" }
declarar eNumero*(ch txt) logico { retorne ch >= "0" && ch <= "9" }
declarar eEspaco*(ch txt) logico { retorne ch == " " || ch == "\t" || ch == "\n" }

declarar criarTokens*(lexer ref Lexer) vazio {
    alocar tokens Token[] = []
    alocar ch txt = ""
    alocar offset int = 0
    alocar src texto = lexer.source
    alocar tamanho inteiro = @tamanho_texto(src)

    enquanto offset < tamanho {
        ch = src[offset++]
        se eEspaco(ch) continuar
        se eNumero(ch) {
            alocar numero txt = ""
            numero ~= ch

            enquanto offset < tamanho && eNumero(src[offset])
                numero ~= src[offset++]

            alocar eDecimal logico = falso
            se src[offset] == "." {
                eDecimal = verdadeiro
                numero ~= "."
                offset++ // pula o '.'
                enquanto offset < tamanho && eNumero(src[offset])
                    numero ~= src[offset++]
            }

            se eDecimal
                tokens ~= Token(TokenKind.Decimal, numero)
            senao
                tokens ~= Token(TokenKind.Inteiro, numero)
            
            continuar
        }
        se eTexto(ch) {
            alocar id txt = ""
            id ~= ch
            
            enquanto offset < tamanho && eTexto(src[offset])
                id ~= src[offset++]
            
            se id == "inteiro" || id == "int" || id == "i64" tokens ~= Token(TokenKind.Inteiro, id)
            senao se id == "texto" || id == "txt" tokens ~= Token(TokenKind.Texto, id)
            senao se id == "vazio" tokens ~= Token(TokenKind.Vazio, id)
            senao se id == "decimal" || id == "dec" tokens ~= Token(TokenKind.Decimal, id)
            // palavras chave
            senao se id == "alocar" tokens ~= Token(TokenKind.Alocar, id)
            senao se id == "principal" tokens ~= Token(TokenKind.Principal, id)
            senao se id == "declarar" tokens ~= Token(TokenKind.Declarar, id)
            senao
                tokens ~= Token(TokenKind.Identificador, id)
            continuar
        }
        // simbolos/sinais
        se ch == "+" { tokens ~= Token(TokenKind.Mais, ch) continuar }
        se ch == "-" { tokens ~= Token(TokenKind.Menos, ch) continuar }
        se ch == "*" { tokens ~= Token(TokenKind.Vezes, ch) continuar }
        se ch == "(" { tokens ~= Token(TokenKind.ParentesesE, ch) continuar }
        se ch == ")" { tokens ~= Token(TokenKind.ParentesesD, ch) continuar }
        se ch == "{" { tokens ~= Token(TokenKind.BracoE, ch) continuar }
        se ch == "}" { tokens ~= Token(TokenKind.BracoD, ch) continuar }
        se ch == "=" { tokens ~= Token(TokenKind.Igual, ch) continuar }
        se ch == "/" { 
            // comentario
            se src[offset] == "/" {
                enquanto offset < tamanho && src[offset] != "\n"
                    offset++
                continuar
            }
            tokens ~= Token(TokenKind.Dividir, ch) 
            continuar
        }

        // erro, caractere desconhecido
        escrevaf("Caractere desconhecido: \"%s\"\n", ch)
        fim
    }
    tokens ~= Token(TokenKind.EoF, "\0")
    lexer.tokens = tokens
}
