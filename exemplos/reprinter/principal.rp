importar lexer

declarar principal vazio {
    alocar codigo texto = "declarar principal vazio { alocar x decimal = 100 * 3.14 } \n"

    alocar lexer Lexer = Lexer([], codigo)
    criarTokens(lexer)
    alocar tamVT int = @tamanho_vetor(lexer.tokens)

    para alocar i int = 0; i < tamVT; i++ {
        escrevaf("TokenTipo: %s\nValor: '%s'\n\n", lexer.tokens[i].tipo, lexer.tokens[i].valor)
    }

    fim
}
