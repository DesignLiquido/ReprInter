importar biblioteca.entrada_saida

enum Precendence* {
    Lowest
    Sum
    Mul
    Highest
}

enum NodeKind* {
    Program = "Program"
    BinaryExpr = "BinaryExpr"
    VarDecl = "VarDecl"
}

estrutura Node* {
    kind NodeKind
    value qualquer
    body Node[]
    left Node
    right Node
}

declarar principal vazio {
    alocar bo Node = Node(NodeKind.BinaryExpr, 0, 0, 0, 0)
    alocar n Node = Node(NodeKind.Program, 0, 0, 0, 0)
    escrevaln(n.kind)
    fim
}
