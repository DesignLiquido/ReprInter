declarar sair(msg texto) vazio {
    @escreva("ERRO: ", msg, "\n")
    fim
}

declarar printf(mensagem texto, ...) vazio {
    alocar argI int = 0
    alocar len int = @tamanho_texto(mensagem)
    alocar ch texto = "" 

    para alocar i int = 0; i < len; i++ {
        ch = mensagem[i]

        se ch == "%" {
            se i + 1 >= len
                sair("Formato inválido: '%' no final do texto.")
            
            i++
            ch = mensagem[i]

            se ch == "%" {
                @escreva("%")
                continuar
            }

            se argI >= varargc
                sair("Argumentos insuficientes para os especificadores de formato")

            se ch == "s" {
                se @tipo(varargs[argI]) != "texto"
                    sair("Esperado tipo Textto para %s")
                @escreva(varargs[argI++])
                continuar
            }
            se ch == "d" {
                se @tipo(varargs[argI]) != "inteiro"
                    sair("Esperado tipo Inteiro para %d")
                @escreva(varargs[argI++])
                continuar
            }
            se ch == "f" {
                se @tipo(varargs[argI]) != "decimal"
                    sair("Esperado tipo Decimal para %f")
                @escreva(varargs[argI++])
                continuar
            }
            se ch == "b" {
                se @tipo(varargs[argI]) != "logico"
                    sair("Esperado tipo Logico para %b")
                @escreva(varargs[argI++])
                continuar
            }
        } senao se ch == "\\" {
            se i + 1 >= len
                sair("Escape inválido: '\\' no final da string")
            i++
            ch = mensagem[i]
            // o motor do reprinter vai lidar com os escapes automaticamente
            @escreva(ch)
        } senao
            @escreva(ch)
    }
}

declarar principal vazio {
    alocar nome texto = "Fernando"
    alocar idade inteiro = 17
    printf("Ola %s, você tem %d anos!\n", nome, idade)
}
