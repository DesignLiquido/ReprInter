externo {
    declarar escrevaln(...) vazio;
}

estrutura Usuario {
    nome txt
}

declarar modificarVetor(vetor ref Usuario[]) vazio {
    vetor[0].nome = "Fernando"
}

declarar principal vazio {
    alocar usuarios Usuario[] = []
    usuarios ~= Usuario("Jão")
    usuarios ~= Usuario("Jonas")

    usuarios[0].nome = "Fernando"
    escrevaln(usuarios[0].nome)

    usuarios[0] = Usuario("Marcelo")

    // recebe por referencia, sem copia profunda
    alocar marcelo Usuario = usuarios[0]
    marcelo.nome = "Marcelo Andrade"
    escrevaln(usuarios[0].nome)

    modificarVetor(usuarios)
    escrevaln(usuarios[0].nome)

    para alocar i int = 0; i < __nucleo_harpy_tamanho_vetor(usuarios); i++ {
        escrevaln("Olá ", usuarios[i].nome)
    }

    fim
}
