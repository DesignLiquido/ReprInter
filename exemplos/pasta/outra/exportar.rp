// forma mais simples de escrever funções externas
importar biblioteca.entrada_saida : { escrevaln }

declarar soma_publica*(x int, y int) int {
    retorne x + y
}

const PI f64 = 3.141592
const E* inteiro = 69

enum Status* {
    Pago = "pago"
    Pendente = "pendente"
}

estrutura Pagamento* {
    status Status
}

declarar mostrar_pi* vazio {
    escrevaln("PI: ", PI)
}

declarar soma_privada(x int, y int) int {
    retorne x + y
}

declarar loop* vazio {
    para alocar i int = 0; i < 10; i++
        @escreva(i, "\n")
}
