// Biblioteca padrão de manipulação de texto

importar biblioteca.entrada_saida : { erro, escrevaln }

declarar contem*(msg texto, busca texto) logico {
    alocar texto_len int = @tamanho_texto(msg)
    alocar busca_len int = @tamanho_texto(busca)
    
    se busca_len > texto_len retorne falso
    
    para alocar i int = 0; i <= texto_len - busca_len; i++ {
        alocar match logico = verdadeiro
        para alocar j int = 0; j < busca_len; j++ {
            se msg[i + j] != busca[j] {
                match = falso
                parar
            }
        }
        se match retorne verdadeiro
    }
    
    retorne falso
}

declarar comeca_com*(msg texto, prefixo texto) logico {
    alocar texto_len int = @tamanho_texto(msg)
    alocar pref_len int = @tamanho_texto(prefixo)
    
    se pref_len > texto_len retorne falso
    
    para alocar i int = 0; i < pref_len; i++
        se msg[i] != prefixo[i]
            retorne falso
    
    retorne verdadeiro
}

declarar termina_com*(msg texto, sufixo texto) logico {
    alocar texto_len int = @tamanho_texto(msg)
    alocar suf_len int = @tamanho_texto(sufixo)
    
    se suf_len > texto_len retorne falso
    
    alocar offset int = texto_len - suf_len
    para alocar i int = 0; i < suf_len; i++
        se msg[offset + i] != sufixo[i]
            retorne falso
    
    retorne verdadeiro
}

declarar juntar*(separador texto, ...texto) texto {
    se varargc == 0 retorne ""
    
    alocar resultado texto = varargs[0]
    para alocar i int = 1; i < varargc; i++ {
        resultado ~= separador
        resultado ~= varargs[i]
    }
    
    retorne resultado
}

declarar repetir*(msg texto, vezes inteiro) texto {
    se vezes <= 0 retorne ""
    
    alocar resultado texto = ""
    para alocar i int = 0; i < vezes; i++
        resultado ~= msg
    
    retorne resultado
}

declarar principal vazio {
    escrevaln(contem("Fernando Dev", "nando"))
    escrevaln(comeca_com("Fernando Dev", "F"))
    escrevaln(termina_com("Fernando Dev", "Dev"))
    escrevaln(juntar(" ", "Fernando", "Dev"))
    escrevaln(repetir("Fernando Dev", 2))
    fim
}
