// Biblioteca padrão para tempo

importar padrao.es : { erro }

const LIMITE_DO_LONG* int = 9_223_372_036_854_775_807

// usando segundos
declarar esperar*(n i64) vazio {
    nesperar(n * 1_000_000_000)
}

// usando microsegundos
declarar mesperar*(n i64) vazio {
    nesperar(n * 1_000_000)
}

// usando nanosegundos
declarar nesperar*(n i64) vazio {
    se n > LIMITE_DO_LONG
        erro("Limite estourado.")
    @nsleep(n)
}

declarar agora*() i64 {
    retorne @microtime()
}

