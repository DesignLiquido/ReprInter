declarar eNumero(ch txt) logico {
    retorne ch >= "0" && ch <= "9"
}

declarar sair*(codigo inteiro = 0) vazio {
    @sair(codigo)
}

declarar erro*(msg texto) vazio {
    escreva("ERRO: ", msg, "\n")
    sair(1)
}

declarar escreva_varrags(args qualquer[]) vazio {
    para alocar i int = 0; i < @tamanho_vetor(args); i++ {
        se @tipo(args[i]) == "vetor" {
            @escrevas("<Vetor>: ")
            escreva_varrags(args[i])
            continuar
        }
        se @tipo(args[i]) == "estrutura" { @escrevas("<Estrutura>") continuar }
        se @tipo(args[i]) == "enum" { @escrevas("<Enum>") continuar }
        se @tipo(args[i]) == "decimal" { @escrevad(args[i], 2) continuar }
        se @tipo(args[i]) == "inteiro" { @escrevai(args[i]) continuar }
        se @tipo(args[i]) == "texto" { @escrevas(args[i]) continuar }
        @escrevas(args[i])
    }
}

declarar escreva*(...) vazio {
    escreva_varrags(varargs)
}

declarar escrevaln*(...) vazio {
    se varargc != 0
        escreva_varrags(varargs)
    @escrevas("\n")
}

declarar escrevaf*(mensagem texto, ...) vazio {
    alocar argI int = 0
    alocar len int = @tamanho_texto(mensagem)
    alocar ch texto = "" 

    para alocar i int = 0; i < len; i++ {
        ch = mensagem[i]

        se ch == "%" {
            se i + 1 >= len
                erro("Formato inválido: '%' no final do texto.")
            
            i++
            ch = mensagem[i]

            se ch == "%" {
                @escrevas("%")
                continuar
            }

            se argI >= varargc
                erro("Argumentos insuficientes para os especificadores de formato")

            se ch == "." {
                i++ // avança o '.' 
                alocar n texto = ""

                enquanto i < len && eNumero(mensagem[i])
                    n ~= mensagem[i++]

                se n == ""
                    erro("Esperado um numero inteiro após o '.'.")
                
                se mensagem[i] != "f"
                    erro("O especificador '.' suporta apenas decimais 'f'.")

                se @tipo(varargs[argI]) != "decimal"
                    erro("Esperado tipo Decimal para %.<n>f")
                
                @escrevad(varargs[argI], @tpi(n))

                continuar
            }

            se ch == "s" {
                se @tipo(varargs[argI]) != "texto"
                    erro("Esperado tipo Texto para %s")
                @escrevas(varargs[argI++])
                continuar
            }
            se ch == "d" {
                se @tipo(varargs[argI]) != "inteiro"
                    erro("Esperado tipo Inteiro para %d")
                @escrevai(varargs[argI++])
                continuar
            }
            se ch == "f" {
                se @tipo(varargs[argI]) != "decimal"
                    erro("Esperado tipo Decimal para %f")
                @escrevad(varargs[argI++], 2)
                continuar
            }
            se ch == "b" {
                se @tipo(varargs[argI]) != "logico"
                    erro("Esperado tipo Logico para %b")
                @escrevab(varargs[argI++])
                continuar
            }
        } senao se ch == "\\" {
            se i + 1 >= len
                erro("Escape inválido: '\\' no final da string")
            i++
            ch = mensagem[i]
            // o motor do reprinter vai lidar com os escapes automaticamente
            @escrevas(ch)
        } senao
            @escrevas(ch)
    }
}

declarar entrada*(mensagem texto = "") texto {
    escreva(mensagem)
    retorne @entrada()
}
