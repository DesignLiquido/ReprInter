// teste_printf.rp
importar biblioteca.entrada_saida : { escrevaf }

declarar principal vazio {
    // Inteiros
    escrevaf("Int: %d\n", 42)
    
    // Decimais
    escrevaf("Float: %f\n", 3.14159)
    escrevaf("Precisão: %.2f %.4f %.10f\n", 3.14159, 3.14159, 3.14159)
    
    // Strings
    escrevaf("String: %s\n", "Hello")
    
    // Booleanos
    escrevaf("Bool: %b\n", verdadeiro)
    
    // Misturado
    escrevaf("Nome: %s, Idade: %d, Altura: %.2f\n", "João", 25, 1.75)
    
    // Escapes
    escrevaf("Linha 1\nLinha 2\tTab\n")
    
    // Literal %
    escrevaf("Progresso: 75%%\n")
    
    // Erros (devem dar erro claro)
    //escrevaf("%d\n", 3.14)  // Erro: Esperado Inteiro
    //escrevaf("%s\n", 42)    // Erro: Esperado Texto
    //escrevaf("Teste %")
    fim
}
