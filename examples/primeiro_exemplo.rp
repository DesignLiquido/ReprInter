// suporte a importação de outros arquivos, copiará todas as funções e constantes
// pro novo contexto (contexto do arquivo que fez o import)
// exemplo de sintaxe:
incluir "nome_do_arquivo.rp"
// a extensão .rp vem de RePrinter

// é uma vm baseada em stack, tudo definido com % será uma variavel, seja temporaria ou não
// variaveis temporarias serão criadas automaticamente com um frontend gerador do IR

// ponto de entrada (obrigatório)
// o ponto de entrada não tem retorno
declarar principal() vazio {
    alocar %0, i32
    %0 = chamar somar(60, 9)
    chamar escreva(%0)
    fim // halt
}

// ...    = variadic com qualquer tipo (void*)
// ...i32 = variadic com tipo i32 (i32*)
declarar escreva(...i32) vazio {
    escrevaPonteiro variadic // a variavel variadic é criada automaticamente
    // escrevaPonteiro é uma instrução que irá escrever tudo que contem dentro do variadic
    // independente do tipo
    // caso tenha o * então ele aceita variadic com qualquer tipo
    // ou variadic será T* ou void*, dependerá da assinatura da função
}

// i32 = inteiro de 32 bits
declarar somar(x i32, y i32) i32 {
    alocar %resultado, i32 // %resultado recebe o endereço dele na stack, o adicionar irá editar esse valor
    adicionar %resultado, x, y
    retornar %resultado
}
