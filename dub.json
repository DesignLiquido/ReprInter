{
	"name": "harpy",
	"description": "The Harpy",
	"targetType": "executable",
	"targetName": "harpy",
	"license": "Apache-2.0",
	"copyright": "Copyright © 2026, Fernando Dev",
	"authors": [
		"Fernando Dev"
	],
	"configurations": [
		{
			"name": "linux",
			"platforms": ["linux"],
			"lflags": ["$PACKAGE_DIR/vendor/mir/lib/linux/libmir.a"],
			"dflags-ldc": ["-L-lm", "-L-ldl", "-L-lpthread"],
			"dflags-dmd": ["-L-lm", "-L-ldl", "-L-lpthread"],
			"dflags-gdc": ["-L-lm", "-L-ldl", "-L-lpthread"]
		},
		{
			"name": "windows",
			"platforms": ["windows"],
			"lflags": [
			  "$PACKAGE_DIR/vendor/mir/lib/windows/libmir.a",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-mingw_vsnprintf.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-mingw_sprintf.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-mingw_vfprintf.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-mingw_fprintf.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-mingw_snprintf.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-strtof.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-strtodg.o",
			  "$PACKAGE_DIR/vendor/mir/lib/windows/mingwex/lib64_libmingwex_a-strtodnrp.o"
			]
		}
	],
	"buildTypes": {
		"debug": {
			"dflags-dmd": ["-g", "-debug"],
			"dflags-ldc": ["-g", "-d-debug", "-O0"],
			"dflags-gdc": ["-g", "-fdebug", "-O0"]
		},
		"release": {
			"dflags-dmd": ["-O", "-release", "-inline"],
			"dflags-ldc": ["-O2", "-release", "-enable-inlining", "-flto=full"],
			"dflags-gdc": ["-O2", "-frelease", "-finline-functions", "-flto"]
		},
		"release-size": {
			"dflags-dmd": ["-O", "-release", "-inline"],
			"dflags-ldc": ["-Oz", "-release", "-flto=full"],
			"dflags-gdc": ["-Os", "-frelease", "-flto"]
		}
	}
}
