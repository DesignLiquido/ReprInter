função fibonacci(n: qualquer) {
    se n <= 1 {
        retorna n
    }
    var a = 0
    var b = 1
    var temp = 0
    para var i = 0; i < n - 1; i++ {
        temp = a + b
        a = b
        b = temp
    }
    retorna b
}
var resultado = fibonacci(92)
escreva('resultado: ', resultado)
se (resultado != 7540113804746346429) {
    escreva('o resultado está errado!')
}
