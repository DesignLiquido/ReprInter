#!/usr/bin/env bash

# Script shell feito pelo Claude porque não sei shell.
# set -e  # Para execução em caso de erro

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Função para print colorido
print_error() { echo -e "${RED}[ERRO]${NC} $1"; }
print_success() { echo -e "${GREEN}[OK]${NC} $1"; }
print_info() { echo -e "${YELLOW}[INFO]${NC} $1"; }

# Verifica se ferramenta existe
tool_exists() {
    command -v "$1" >/dev/null 2>&1
}

# --- Configuráveis por ambiente ou argumentos ---
# Exporte SKIP_STRIP=1 ou SKIP_UPX=1 para pular etapas
SKIP_STRIP=${SKIP_STRIP:-0}
SKIP_UPX=${SKIP_UPX:-0}

# Permite passar flags na linha de comando: --no-strip | --no-upx
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-strip|-ns)
            SKIP_STRIP=1; shift;;
        --no-upx|-nu)
            SKIP_UPX=1; shift;;
        --help|-h)
            echo "Uso: $0 [--no-strip] [--no-upx]"; exit 0;;
        *)
            shift;;
    esac
done

# Função que tenta aplicar strip e upx em um arquivo, sem abortar o script por falha nessas etapas
apply_strip_and_upx() {
    local file="$1"

    [[ ! -f "$file" ]] && return 0

    # STRIP
    if [[ "$SKIP_STRIP" != "1" ]]; then
        if tool_exists strip; then
            print_info "Stripando: $file"
            if strip --strip-all "$file"; then
                print_success "Strip aplicado: $file"
            else
                print_error "Falha ao stripar $file — seguindo sem abortar"
            fi
        else
            print_info "strip não encontrado; pulando strip para $file"
        fi
    else
        print_info "SKIP_STRIP ativo — pulando strip para $file"
    fi

    # UPX
    if [[ "$SKIP_UPX" != "1" ]]; then
        if [[ "$file" != *.so ]]; then
            if tool_exists upx; then
                print_info "Compressão UPX: $file"
                # tenta upx com --best --lzma; se falhar, avisa e continua
                if upx --best --lzma "$file"; then
                    print_success "UPX aplicado: $file"
                else
                    print_error "Falha ao aplicar UPX em $file — seguindo sem abortar"
                fi
            else
                print_info "upx não encontrado; pulando compressão para $file"
            fi
        else
            print_info "Arquivo $file é .so — pulando UPX"
        fi
    else
        print_info "SKIP_UPX ativo — pulando UPX para $file"
    fi
}

# Valida estrutura do projeto
validate_project_structure() {
    local missing=()
    
    [[ ! -d "./stdlib" ]] && missing+=("./stdlib")
    [[ ! -d "./bibliotecas" ]] && missing+=("./bibliotecas")
    [[ ! -f "./dub.json" ]] && missing+=("./dub.json")
    [[ ! -f "./README.md" ]] && missing+=("./README.md")
    [[ ! -d "./src" ]] && missing+=("./src")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "Estrutura de projeto inválida. Faltando:"
        printf '  - %s\n' "${missing[@]}"
        print_info "Execute este script no diretório root do projeto HarpyVM"
        exit 1
    fi
}

# Verifica ferramentas necessárias
check_dependencies() {
    local missing=()
    
    tool_exists "ldc2" || missing+=("ldc2")
    tool_exists "dub" || missing+=("dub")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "Ferramentas necessárias não encontradas:"
        printf '  - %s\n' "${missing[@]}"
        print_info "Instale as dependências e tente novamente"
        exit 1
    fi
}

# Setup de diretórios
setup_directories() {
    HOME="${HOME:-$(eval echo ~)}"
    MAIN_DIR="$HOME/.harpy"
    DIR_LIBS="$MAIN_DIR/libs"
    DIR_BIN="$HOME/.local/bin"
    
    print_info "Configurando diretórios..."
    
    mkdir -p "$MAIN_DIR" "$DIR_LIBS" "$DIR_BIN"
    
    print_success "Diretórios configurados:"
    echo "  ~/.harpy/libs/ - Bibliotecas do sistema"
    echo "  ~/.local/bin/  - Binário executável"
}

# Compila bibliotecas do sistema (.so)
compile_system_libraries() {
    print_info "Compilando bibliotecas do sistema..."
    
    local compiled=0
    
    for src_file in ./stdlib/*.d; do
        [[ ! -f "$src_file" ]] && continue
        
        local basename=$(basename "$src_file" .d)
        local output="./stdlib/${basename}.so"
        
        print_info "  Compilando $basename..."
        
        if ldc2 -shared -of="$output" "$src_file" "src/stdlib_base.d" -link-defaultlib-shared --betterC; then
            cp -f "$output" "$DIR_LIBS/"
            # aplica strip/upx no arquivo copiado
            apply_strip_and_upx "$DIR_LIBS/$basename.so"
            ((compiled++))
        else
            print_error "Falha ao compilar $basename"
            exit 1
        fi
    done

    # biblioteca padrão
    cp -rf bibliotecas/* "$MAIN_DIR"

    print_success "Bibliotecas compiladas: $compiled"
}

# Compila o projeto principal
compile_project() {
    print_info "Compilando projeto principal com dub..."
    
    if dub build --quiet --build=release --compiler=ldc2; then
        print_success "Projeto compilado com sucesso"
    else
        print_error "Falha na compilação do projeto"
        exit 1
    fi
    
    if [[ -f "./harpy" ]]; then
        print_info "Instalando binário em ~/.local/bin/..."
        cp -f "./harpy" "$DIR_BIN/"
        chmod +x "$DIR_BIN/harpy"
        # aplica strip/upx no binário final
        apply_strip_and_upx "$DIR_BIN/harpy"
        print_success "Binário instalado"
    else
        print_error "Binário 'harpy' não encontrado após build"
        exit 1
    fi
}

# Configura PATH no shell config
setup_path() {
    local shell_config=""
    local current_shell=$(basename "$SHELL")
    
    case "$current_shell" in
        bash)
            shell_config="$HOME/.bashrc"
            ;;
        zsh)
            shell_config="$HOME/.zshrc"
            ;;
        fish)
            shell_config="$HOME/.config/fish/config.fish"
            print_info "Fish detectado - configure manualmente o PATH"
            return
            ;;
        *)
            print_info "Shell não detectado automaticamente"
            return
            ;;
    esac
    
    # Verifica se PATH já está configurado
    if grep -q "/.local/bin" "$shell_config" 2>/dev/null; then
        print_info "PATH já configurado em $shell_config"
        return
    fi
    
    print_info "Adicionando ~/.local/bin ao PATH em $shell_config..."
    
    cat >> "$shell_config" << 'EOF'

# HarpyVM - PATH para binários locais
export PATH="$HOME/.local/bin:$PATH"
EOF
    
    print_success "PATH configurado em $shell_config"
    print_info "Execute: source $shell_config  (ou reinicie o terminal)"
}

# Verifica se PATH está configurado
check_path() {
    if [[ ":$PATH:" == *":$HOME/.local/bin:"* ]]; then
        print_success "~/.local/bin já está no PATH"
    else
        print_info "~/.local/bin NÃO está no PATH da sessão atual"
        setup_path
    fi
}

# Main
main() {
    echo "========================================"
    echo "  HarpyVM - Build & Installation Script"
    echo "========================================"
    echo
    
    # Detecta sistema operacional
    case "$(uname -s)" in
        Linux*)
            print_success "Sistema: Linux"
            ;;
        Darwin*)
            print_success "Sistema: macOS"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            print_error "Windows não suportado ainda"
            exit 1
            ;;
        *)
            print_error "Sistema operacional não suportado"
            exit 1
            ;;
    esac
    
    echo
    validate_project_structure
    check_dependencies
    setup_directories
    echo
    compile_system_libraries
    echo
    compile_project
    echo
    check_path
    
    echo
    echo "========================================"
    print_success "Build concluído com sucesso!"
    echo "========================================"
    echo
    echo "Para usar o HarpyVM:"
    echo "  1. Recarregue seu shell: source ~/.bashrc  (ou ~/.zshrc)"
    echo "  2. Execute: harpy --ajuda"
}

main "$@"
