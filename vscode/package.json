{
  "name": "harpy",
  "displayName": "harpy",
  "description": "Extensão para a linguagem Harpy",
  "version": "0.0.9",
  "publisher": "FarpyOrganization",
  "icon": "./imagens/icon.png",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "harpy",
      "aliases": ["harpy"],
      "extensions": [".hrp", ".hvm"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./imagens/icone-harpy.png",
        "dark": "./imagens/icone-harpy.png"
      }
    }],
    "grammars": [{
      "language": "harpy",
      "scopeName": "fonte.hrp",
      "path": "./sintaxes/harpy.tmLanguage.json"
    }],
    "snippets": [
      {
        "language": "harpy",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
