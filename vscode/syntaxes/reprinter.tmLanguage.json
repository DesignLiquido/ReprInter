{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "RePrinter",
	"scopeName": "source.rp",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.reprinter",
				"match": "\\b(alocar|declarar|se|senao|importar|fim|enum|estrutura|enumeracao|const|constante|vazio|int|inteiro|i64|f32|dec|decimal|f64|txt|texto|qqr|qualquer|logico|para|retorne|externo|enquanto|continuar|parar|ref)\\b"
			}]
		},
		"strings": {
			"patterns": [{
				"name": "string.quoted.double.reprinter",
				"begin": "\"",
				"end": "\"",
				"patterns": [{
					"name": "constant.character.escape.reprinter",
					"match": "\\\\."
				}]
			}]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.reprinter",
					"match": "//.*$"
				},
				{
					"name": "comment.line.hash.reprinter",
					"match": "#.*$"
				},
				{
					"name": "comment.block.reprinter",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.reprinter",
					"match": "\\b0[xX][0-9A-Fa-f](_?[0-9A-Fa-f])*\\b"
				},
				{
					"name": "constant.numeric.reprinter",
					"match": "\\b\\d+(_\\d+)*(\\.\\d+(_\\d+)*)?\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.reprinter",
					"match": "\\+|\\-|\\*|\\/|%"
				},
				{
					"name": "keyword.operator.comparison.reprinter",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.logical.reprinter",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.assignment.reprinter",
					"match": "=|\\+=|\\-=|\\*=|\\/=|%="
				},
				{
					"name": "keyword.operator.bitwise.reprinter",
					"match": "&|\\||\\^|~|<<|>>"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.reprinter",
					"match": ";"
				},
				{
					"name": "punctuation.separator.reprinter",
					"match": ","
				},
				{
					"name": "punctuation.accessor.reprinter",
					"match": "\\."
				},
				{
					"name": "punctuation.section.braces.reprinter",
					"match": "\\{|\\}"
				},
				{
					"name": "punctuation.section.brackets.reprinter",
					"match": "\\[|\\]"
				},
				{
					"name": "punctuation.section.parens.reprinter",
					"match": "\\(|\\)"
				}
			]
		},
		"functions": {
			"patterns": [{
				"name": "entity.name.function.reprinter",
				"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
			}]
		},
		"identifiers": {
			"patterns": [{
				"name": "variable.other.reprinter",
				"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
			}]
		}
	}
}
